# ==============================================================================
# Brilian – Intelligent Document Management System (AI-Powered DMS)
# Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root and adjust the values accordingly.
# Reference: dokumentasi_lengkap_brilian.md, arsitektur_sistem_direktori.md,
#            kebijakan_keamanan.md, and PROJECT.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port on which the HTTP server will listen.
# Default: 8080
SERVER_PORT=8080

# Gin web framework mode: 'debug' for local development, 'release' for production, 'test' for tests.
# Default: release
GIN_MODE=release

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16 with pgvector & tsvector)
# ------------------------------------------------------------------------------
# Hostname or IP address of the PostgreSQL server.
# For local development outside Docker: 'localhost' or '127.0.0.1'
# For Docker Compose networking: 'postgres'
DB_HOST=localhost

# Port of the PostgreSQL server.
# Default: 5432
DB_PORT=5432

# PostgreSQL username.
# Default: brilian_user
DB_USER=brilian_user

# PostgreSQL user password.
# Warning: Replace with a cryptographically strong password in production.
DB_PASSWORD=secure_password_here

# PostgreSQL database name.
# Default: brilian_db
DB_NAME=brilian_db

# PostgreSQL SSL connection mode: 'disable', 'require', 'verify-ca', 'verify-full'.
# For local development / Docker internal network: 'disable'
# For cloud/production environments: 'require' or 'verify-full'
DB_SSLMODE=disable

# ------------------------------------------------------------------------------
# 3. Object Storage Configuration (MinIO - Dual-Layer AES-256 Storage Backend)
# ------------------------------------------------------------------------------
# MinIO S3 API endpoint (<host>:<port>).
# For local development outside Docker: 'localhost:9000'
# For Docker Compose networking: 'minio:9000'
MINIO_ENDPOINT=localhost:9000

# MinIO root/access key (MINIO_ROOT_USER).
# Default: minio_admin
MINIO_ACCESS_KEY=minio_admin

# MinIO secret key (MINIO_ROOT_PASSWORD).
# Warning: Replace with a cryptographically strong secret in production.
MINIO_SECRET_KEY=minio_secret_password

# S3 bucket name for encrypted document storage.
# Default: brilian-documents
MINIO_BUCKET_NAME=brilian-documents

# Whether to use SSL/TLS for MinIO communication: 'true' or 'false'.
# Default: false (for local development/Docker internal network)
MINIO_USE_SSL=false

# ------------------------------------------------------------------------------
# 4. AI Agent & Cloud API Configuration (Enterprise Zero Data Retention)
# ------------------------------------------------------------------------------
# AI Provider: 'vertex_ai' (Google Cloud Vertex AI) or 'mock' (for automated unit/e2e testing).
# Default: vertex_ai
AI_PROVIDER=vertex_ai

# Enterprise API key / token with Zero Data Retention contract.
# In test/mock mode, this can be any non-empty string.
AI_API_KEY=your_enterprise_zero_data_retention_api_key

# Model name: 'gemini-1.5-flash' (fast, default) or 'gemini-1.5-pro' (complex analysis).
# Default: gemini-1.5-flash
AI_MODEL_NAME=gemini-1.5-flash

# Google Cloud Region for Vertex AI API endpoint.
# Default: us-central1
AI_REGION=us-central1

# ------------------------------------------------------------------------------
# 5. Security & In-Memory Encryption Configuration
# ------------------------------------------------------------------------------
# AES-256 master key in hexadecimal representation (must be EXACTLY 64 hex characters = 32 bytes).
# Used for encrypting system prompts in memory and document chunks at-rest.
# Example: 64-character hex string (32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Path to the on-premise hardware-bound license file.
# Default: ./license.lic
LICENSE_FILE_PATH=./license.lic

# ------------------------------------------------------------------------------
# 6. Authentication & RBAC (Extended Options)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens for RBAC authentication (admin, reviewer, uploader, viewer).
# Default: brilian_jwt_secret_signing_key_at_least_32_bytes_long
JWT_SECRET=brilian_jwt_secret_signing_key_at_least_32_bytes_long

# JWT token expiration time in hours.
# Default: 24
JWT_EXPIRATION_HOURS=24
